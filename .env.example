# Copy this file to .env and fill in your key.
# Get an API key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: a class code students must type before using the app (recommended if it's online).
STUDY_BUDDY_ACCESS_CODE=

# Optional: requests allowed per student (per browser), as "requests/seconds". Default 30/600. Use 0 to turn off.
STUDY_BUDDY_RATE_LIMIT=30/600

# Optional: requests allowed per internet connection (a class often shares one). Default 300/600.
STUDY_BUDDY_NETWORK_RATE_LIMIT=300/600

# Optional: number of proxies in front of the app. Use 1 on hosts like Render, Railway or Fly. Leave empty otherwise.
STUDY_BUDDY_TRUST_PROXY=

# Optional: which Claude model to use.
STUDY_BUDDY_MODEL=claude-opus-5
